.idea
# Gradle build directories, matched by depth rather than **/build: build-logic's convention
# plugins live in package org.apache.grails.intellij.build, so **/build silently swallowed
# build-logic/src/main/groovy/org/apache/grails/intellij/build/ and its sources were never
# committed. Depths cover /build, <project>/build and <tier>/<project>/build, the same shape
# the RAT excludes use.
/build/
/*/build/
/*/*/build/
**/.gradle
**/.intellijPlatform
.kotlin
gradle-bootstrap/gradlew
gradle-bootstrap/gradlew.bat
gradle-bootstrap/gradle
/.claude
*.hprof
.DS_Store
# reproducible-build and release-verification output (etc/bin/*.sh)
etc/bin/results
# Third-party test fixture jars, resolved from Maven at test time by plugin/build.gradle rather
# than committed: ASF source releases must not ship third-party binaries, and hibernate-core is
# LGPL 2.1 (Category X), which may not sit in the repository at all.
/plugin/testdata/mockGrails11/dist/*.jar
/plugin/testdata/mockGrails11/lib/*.jar
/plugin/testdata/mockGrails14/*.jar
