<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" package="org.apache.grails.intellij.plugin">
  <id>org.intellij.grails</id>
  <name>Apache Grails</name>
  <category>JVM Frameworks</category>
  <description>
    <![CDATA[
   Provides integration with the <a href="https://grails.apache.org">Apache Grails</a> framework.
   <ul>
     <li>Import a generated Grails project or create a new one directly from the IDE</li>
     <li>Switch to the <b>Grails</b> view in the <b>Project</b> tool window</li>
     <li>Edit Grails files with coding assistance features, such as code completion, navigation, inspections, refactoring, and much more</li>
     <li>Use dedicated Grails run/debug configurations</li>
   </ul>
    ]]>
  </description>
  <vendor url="https://grails.apache.org/">Apache Software Foundation</vendor>

  <dependencies>
    <plugin id="com.intellij.java"/>
    <plugin id="com.intellij.javaee"/>
    <plugin id="com.intellij.javaee.web"/>
    <module name="intellij.javaee.platform"/>
    <module name="intellij.javaee.platform.impl"/>
    <plugin id="com.intellij.persistence"/>
    <plugin id="com.intellij.javaee.jpa"/>
    <plugin id="com.intellij.jsp"/>
    <plugin id="com.intellij.javaee.el"/>
    <plugin id="org.intellij.groovy"/>
    <plugin id="com.intellij.properties"/>
    <plugin id="com.intellij.database"/>

    <plugin id="com.intellij.spring"/>
    <module name="intellij.spring"/>
    <module name="intellij.spring.core"/>

    <plugin id="org.jetbrains.plugins.gradle"/>
    <plugin id="com.intellij.modules.ultimate"/>
    <plugin id="com.intellij.microservices.jvm"/>
    <module name="intellij.properties.backend"/>
    <module name="intellij.properties.backend.psi"/>
    <module name="intellij.regexp"/>
  </dependencies>

  <content namespace="grails">
    <module name="org.apache.grails.intellij.module.copyright"/>
    <module name="org.apache.grails.intellij.module.i18n"/>
    <module name="org.apache.grails.intellij.module.maven"/>
    <module name="org.apache.grails.intellij.module.hibernate"/>
    <module name="org.apache.grails.intellij.module.langInjection"/>
    <module name="org.apache.grails.intellij.module.coverage"/>
  </content>

