    <intentionAction>
      <language>Groovy</language>
      <className>org.apache.grails.intellij.plugin.actions.GrailsCreateActionByUsageIntention</className>
      <categoryKey>library.name</categoryKey>
    </intentionAction>

    <!-- Spring Support -->
    <renamePsiElementProcessor implementation="org.apache.grails.intellij.plugin.spring.GrLightVariableRenameProcessor" id="GrLightVariableRenameProcessor"/>
    <spring.customModuleComponentsDiscoverer implementation="org.apache.grails.intellij.plugin.spring.GrailsSpringBeanDiscoverer"/>

    <codeInsight.lineMarkerProvider language="Groovy" implementationClass="org.apache.grails.intellij.plugin.spring.SpringInjectionAnnotator"/>

    <completion.contributor language="Groovy" implementationClass="org.apache.grails.intellij.plugin.spring.GrailsInjectedBeanCompletionContributor" order="before groovyBasic"/>
    <aliasingPsiTargetMapper implementation="org.apache.grails.intellij.plugin.spring.SpringGrailsTargetMapper"/>
    <aliasingPsiTargetMapper implementation="org.apache.grails.intellij.plugin.spring.GrailsSpringStereotypeAliasingPsiTargetMapper"/>
    <referencesSearch implementation="org.apache.grails.intellij.plugin.spring.SpringBeanReferenceSearcher"/>

    <debugger.positionManagerFactory implementation="org.apache.grails.intellij.plugin.lang.gsp.debug.GspPositionManagerFactory"/>

    <defaultLiveTemplates file="liveTemplates/gsp.xml"/>
    <iconProvider implementation="org.apache.grails.intellij.plugin.projectView.GrailsIconProvider"/>
    <postStartupActivity implementation="org.apache.grails.intellij.plugin.structure.sync.GrailsStartupActivity"/>
    <postStartupActivity implementation="org.apache.grails.intellij.plugin.structure.GrailsApplicationManagerRefresher"/>
    <backgroundPostStartupActivity implementation="org.apache.grails.intellij.plugin.structure.sync.GrailsMvcStructureRefresher"/>
    <editorNotificationProvider implementation="org.apache.grails.intellij.plugin.editor.GrailsEditorDecorator"/>
    <projectViewPane implementation="org.apache.grails.intellij.plugin.projectView.GrailsProjectViewPane"/>
    <treeStructureProvider implementation="org.apache.grails.intellij.plugin.projectView.GrailsTreeStructureProvider"/>
    <multiHostInjector implementation="org.apache.grails.intellij.plugin.pluginSupport.assetPipeline.AssetScriptInjector"/>
    <psi.referenceContributor language="GSP"
                              implementation="org.apache.grails.intellij.plugin.pluginSupport.assetPipeline.AssetReferenceContributor"/>
    <semContributor implementation="org.apache.grails.intellij.plugin.spring.GrailsSpringSemContributor"/>

    <ignoredFileProvider implementation="org.apache.grails.intellij.plugin.config.GrailsIgnoredProvider"/>
    <notificationGroup id="Grails notifications" displayType="TOOL_WINDOW" toolWindowId="Grails Console" bundle="messages.GrailsBundle" key="notification.group.grails.notifications"/>
    <notificationGroup id="grails" displayType="BALLOON" bundle="messages.GrailsBundle" key="notification.group.grails"/>
    <notificationGroup id="Grails Configure" displayType="BALLOON" key="notification.group.display.name.grails.configure"/>
    <postStartupActivity implementation="org.apache.grails.intellij.plugin.mvc.MvcModuleStructureSynchronizer$MyPostStartUpActivity"/>
    <roots.watchedRootsProvider implementation="org.apache.grails.intellij.plugin.mvc.MvcWatchedRootProvider"/>
    <pathMacroContributor implementation="org.apache.grails.intellij.plugin.mvc.MvcPathMacros"/>

    <dependencySupport coordinate="org.grails:grails-core" kind="java" displayName="Grails Framework"/>
    <dependencySupport coordinate="org.grails:grails-datastore-gorm" kind="java" displayName="GORM"/>
  </extensions>

  <actions>
    <action id="grails.ViewGrailsEditorToolbarAction" class="org.apache.grails.intellij.plugin.editor.ViewGrailsEditorToolbarAction">
      <add-to-group group-id="UIToggleActions" anchor="after" relative-to-action="ViewToolButtons"/>
    </action>

    <group id="grails.toolbar">
      <group
        id="grails.goto.domain"
        class="org.apache.grails.intellij.plugin.editor.toolbar.GoToDomainAction"
        icon="AllIcons.Nodes.DataTables"/>
      <group
        id="grails.goto.controller"
        class="org.apache.grails.intellij.plugin.editor.toolbar.GoToControllerAction"
        icon="AllIcons.Nodes.Controller"/>
      <group
        id="grails.goto.service"
        class="org.apache.grails.intellij.plugin.editor.toolbar.GoToServiceAction"
        icon="AllIcons.FileTypes.Config"/>
      <group
        id="grails.goto.view"
        class="org.apache.grails.intellij.plugin.editor.toolbar.GoToViewAction"
        icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Gsp_logo"/>
      <group
        id="grails.goto.test"
        class="org.apache.grails.intellij.plugin.editor.toolbar.GoToTestAction"
        icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Grails_test"/>
    </group>

    <group id="Grails" class="org.apache.grails.intellij.plugin.actions.GrailsActionGroup"
           icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Grails">
      <action
        id="Grails.DomainClass"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsDomainClassAction"
        icon="AllIcons.Nodes.DataTables"/>
      <action
        id="Grails.Controller"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsControllerAction"
        icon="AllIcons.Nodes.Controller"/>
      <action
        id="Grails.Service"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsServiceAction"
        icon="AllIcons.FileTypes.Config"/>
      <action
        id="Grails.Interceptor"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsInterceptorAction"
        icon="AllIcons.General.Filter"/>
      <action
        id="Grails.Filter"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsFilterAction"
        icon="AllIcons.General.Filter"/>
      <action
        id="Grails.Script"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsScriptAction"
        icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Grails"/>
      <action
        id="Grails.TagLib"
        class="org.apache.grails.intellij.plugin.actions.NewGrailsTagLibAction"
        icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Taglib"/>
      <action id="Grails.GSP" class="org.apache.grails.intellij.plugin.actions.NewGspAction"
              icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Gsp_logo"/>
      <separator/>
      <add-to-group group-id="NewGroup" anchor="first"/>
    </group>

    <!-- old id kept to avoid breaking user keymaps -->
    <action id="Mvc.RunTarget" class="org.apache.grails.intellij.plugin.actions.GrailsRunCommandAction">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="AddFrameworkSupport"/>
      <add-to-group group-id="NavbarPopupMenu" anchor="after" relative-to-action="AddFrameworkSupport"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>

    <group id="Grails.Actions" class="org.apache.grails.intellij.plugin.actions.GrailsActionGroup"
           icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Grails" popup="true">
      <action id="Grails.Plugins"
              class="org.apache.grails.intellij.plugin.mvc.plugins.MvcPluginsAction"
              icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Groovy_mvc_plugin"/>
      <action id="Grails.ChangeSDK" class="org.apache.grails.intellij.plugin.actions.GrailsConfigureSDKAction"
              icon="org.apache.grails.intellij.plugin.GroovyMvcIcons.Grails"/>
      <action id="Grails.UpdateSettings" class="org.apache.grails.intellij.plugin.actions.UpdateGrailsSettingsAction"
              icon="AllIcons.Actions.Refresh"/>
      <reference ref="Mvc.RunTarget"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="AddFrameworkSupport"/>
      <add-to-group group-id="NavbarPopupMenu" anchor="after" relative-to-action="AddFrameworkSupport"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </group>

    <action id="Generate.GrailsView"
            class="org.apache.grails.intellij.plugin.actions.GrailsGenerateViewAction">
      <add-to-group group-id="GenerateGroup"/>
    </action>

    <action id="Grails.WAR" class="org.apache.grails.intellij.plugin.actions.GrailsWarAction">
      <add-to-group group-id="BuildMenu" anchor="last"/>
    </action>
  </actions>

  <xi:include href="grails-method-descriptors.xml"/>

  <!-- GSON -->
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="Groovy" extensions="gson"/>
    <psi.referenceContributor language="Groovy" implementation="org.apache.grails.intellij.plugin.gson.GsonReferenceContributor"/>
    <readWriteAccessDetector id="gson" order="before defaultGroovy"
                             implementation="org.apache.grails.intellij.plugin.gson.GsonRWAccessDetector"/>
    <referencesSearch implementation="org.apache.grails.intellij.plugin.gson.GsonTemplateReferenceQueryExecutor"/>
  </extensions>
  <extensions defaultExtensionNs="org.intellij.groovy">
    <expectedPackageNameProvider implementation="org.apache.grails.intellij.plugin.gson.GsonExpectedPackageProvider"/>
    <importContributor implementation="org.apache.grails.intellij.plugin.gson.GsonImportContributor"/>
    <astTransformationSupport implementation="org.apache.grails.intellij.plugin.gson.GsonTransformationSupport" order="before defaultSupport"/>
    <membersContributor implementation="org.apache.grails.intellij.plugin.gson.GrailsStreamingJsonBuilderContributor"/>
    <membersContributor implementation="org.apache.grails.intellij.plugin.gson.GsonTemplateRendererContributor"/>
    <namedArgumentProvider implementation="org.apache.grails.intellij.plugin.gson.GsonModelArgumentsProvider"/>
    <namedArgumentProvider implementation="org.apache.grails.intellij.plugin.gson.GsonRenderNamedArgumentsProvider"/>
    <positionManagerDelegate implementation="org.apache.grails.intellij.plugin.gson.GsonPositionManagerDelegate"/>
  </extensions>
</idea-plugin>
