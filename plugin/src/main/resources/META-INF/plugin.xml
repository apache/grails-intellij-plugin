    <!-- Each entry must match a jar in the plugin's lib/ directory exactly; JPS resolves them by
         name and silently skips anything it cannot find, so a stale entry disables the Grails JPS
         builders with nothing more than a line in idea.log. These names are pinned by the
         org.apache.grails.intellij.build.intellij-lib convention plugin rather than derived from
         rootProject.name, which is what let this attribute go stale previously. -->
    <compileServer.plugin classpath="org.apache.grails.intellij.compiler.jps-plugin.jar;org.apache.grails.intellij.compiler.grails-compiler-patch.jar"/>

