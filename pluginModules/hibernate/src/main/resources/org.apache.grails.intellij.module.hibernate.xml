<!--
  Optional content module: skipped when com.intellij.hibernate is absent (e.g. Community
  Edition). The extension registrations live here, in the module descriptor, because the
  module classes are loaded by the module's own classloader: registering them from the main
  plugin's config-file would load them with the main plugin classloader, which cannot see
  the content-module jar and fails with ClassNotFoundException.
-->
<idea-plugin>

  <dependencies>
    <plugin id="com.intellij.hibernate"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <persistence.packagesProvider implementation="org.apache.grails.intellij.module.hibernate.GormSessionFactoryContributor"/>
    <postStartupActivity implementation="org.apache.grails.intellij.module.hibernate.Grails3HibernateFacetActivity"/>
  </extensions>

  <extensions defaultExtensionNs="org.intellij.grails">
    <facetProvider implementation="org.apache.grails.intellij.module.hibernate.GormHibernateFacetProvider"/>
  </extensions>

</idea-plugin>
